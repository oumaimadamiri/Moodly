# Copier ce fichier en `.env` et remplir avec vos vraies valeurs.
# Le fichier `.env` ne doit JAMAIS être versionné.

# Clé secrète Django — générer une nouvelle valeur en production
# (ex: python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())")
SECRET_KEY=changeme-django-secret-key

# Mode debug : True en dev, False en prod
DEBUG=True

# Hôtes autorisés, séparés par des virgules
ALLOWED_HOSTS=localhost,127.0.0.1

# Identifiants SMTP Gmail
# Pour EMAIL_HOST_PASSWORD : générer un App Password sur
# https://myaccount.google.com/apppasswords (PAS le mot de passe du compte)
EMAIL_HOST_USER=votre-email@gmail.com
EMAIL_HOST_PASSWORD=votre-app-password-gmail
